---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business } from '../content/business';
const serviceIcons = ['walk', 'paw', 'bowl', 'home'] as const;
---

<BaseLayout>
  <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-cream focus:px-4 focus:py-3" href="#main">Skip to content</a>
  <header class="relative z-20">
    <div class="site-shell flex items-center justify-center py-4 text-center">
      <nav aria-label="Main navigation" class="hidden items-center justify-center gap-8 md:flex">
        <a class="nav-link" href="#services">Services</a>
        <a class="nav-link" href="#care">Our care</a>
        <a class="nav-link" href="#areas">Areas</a>
        <a class="rounded-full border border-forest px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-forest hover:text-cream" href="#contact">Get in touch</a>
      </nav>
      <details class="group w-full max-w-xs md:hidden">
        <summary class="mx-auto flex min-h-11 w-fit cursor-pointer list-none items-center justify-center gap-2 rounded-full border border-olive/50 px-5 py-2 text-sm font-semibold" aria-label="Navigation menu">
          <Icon name="menu" class="h-5 w-5 group-open:hidden" />
          <span class="hidden text-xl leading-none group-open:block" aria-hidden="true">×</span>Menu
        </summary>
        <nav aria-label="Mobile navigation" class="mt-4 flex flex-col gap-1 rounded-2xl border border-gold/60 bg-cream p-3">
          <a class="rounded-lg px-4 py-3 hover:bg-sage/20" href="#services">Services</a>
          <a class="rounded-lg px-4 py-3 hover:bg-sage/20" href="#care">Our care</a>
          <a class="rounded-lg px-4 py-3 hover:bg-sage/20" href="#areas">Areas</a>
          <a class="rounded-lg bg-forest px-4 py-3 text-cream" href="#contact">Get in touch</a>
        </nav>
      </details>
    </div>
  </header>
  <main id="main" tabindex="-1" class="text-center">
    <section id="top" class="relative isolate overflow-hidden border-b border-gold/45">
      <div class="pointer-events-none absolute inset-0 -z-10 opacity-25" aria-hidden="true">
        <img src="/assets/leaf-ornament.svg" alt="" class="absolute -left-10 -top-7 w-40 rotate-[-8deg] sm:w-56" />
        <img src="/assets/leaf-ornament.svg" alt="" class="absolute -right-10 -top-7 w-40 -scale-x-100 rotate-[-8deg] sm:w-56" />
      </div>
      <div class="site-shell pb-10 pt-6 sm:pb-12 sm:pt-8 lg:pb-14">
        <div class="mx-auto max-w-4xl">
          <p class="eyebrow">Dog walking & care in Derbyshire</p>
          <h1 class="mt-4 text-balance font-display text-[clamp(2.75rem,7vw,6rem)] font-semibold leading-[1.02] tracking-[-0.035em]">{business.name}</h1>
          <div class="mx-auto my-4 flex max-w-sm items-center gap-4 text-olive" aria-hidden="true"><span class="h-px flex-1 bg-gold"></span><Icon name="paw" class="h-5 w-5" /><span class="h-px flex-1 bg-gold"></span></div>
          <p class="mx-auto max-w-2xl text-balance font-display text-2xl italic leading-snug text-olive sm:text-3xl">{business.tagline}</p>
          <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-forest/80 sm:text-lg">Thoughtful walks and at-home visits, shaped around your dog’s routine and the care they love.</p>
          <div class="button-row mt-6">
            <a href={business.phoneHref} class="action-button bg-forest text-cream hover:bg-olive">Call {business.phone}<Icon name="arrow" class="h-5 w-5 shrink-0" /></a>
            <a href="#services" class="action-button border border-olive/60 hover:bg-olive/10">Explore services</a>
          </div>
          <p class="mx-auto mt-5 max-w-lg text-sm leading-6 text-olive">Friendly, personal care across Derby and nearby areas</p>
        </div>
      </div>
    </section>
    <section id="services" class="site-shell section-space">
      <div class="section-heading">
        <p class="eyebrow">Here when you need us</p>
        <h2 class="section-title">Care that fits their day</h2>
        <p class="section-copy">From energetic countryside walks to reassuring pop-in visits, every dog gets care that suits them.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {business.services.map((service, index) => (
          <article class="flex flex-col items-center rounded-3xl border border-gold/65 bg-white/25 p-6 sm:p-8">
            <span class="mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-olive text-cream"><Icon name={serviceIcons[index]} class="h-7 w-7" /></span>
            <h3 class="flex min-h-14 items-center justify-center text-balance font-display text-2xl font-semibold leading-7">{service.title}</h3>
            <p class="mt-4 text-sm leading-6 text-forest/80">{service.description}</p>
          </article>
        ))}
      </div>
    </section>
    <section id="care" class="relative overflow-hidden bg-forest text-cream">
      <div class="site-shell section-space">
        <div class="section-heading">
          <p class="eyebrow text-sage">Peace of mind for you</p>
          <h2 class="section-title">Good care starts with trust.</h2>
          <p class="section-copy text-cream/80">Your dog’s wellbeing comes first. Feel confident they’re in caring, capable hands while you’re away.</p>
        </div>
        <ul class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2">
          {business.qualifications.map((qualification) => <li class="flex min-h-24 flex-col items-center justify-center gap-3 rounded-2xl border border-cream/20 px-5 py-6 sm:flex-row"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cream/10 text-cream"><Icon name="check" class="h-5 w-5" /></span><span class="font-display text-xl leading-7">{qualification}</span></li>)}
        </ul>
        <a href="#contact" class="mt-8 inline-flex min-h-11 items-center justify-center gap-3 font-semibold text-cream underline decoration-gold underline-offset-8 hover:text-sage">Let’s talk about your dog<Icon name="arrow" class="h-5 w-5 shrink-0" /></a>
      </div>
    </section>
    <section id="areas" class="site-shell section-space">
      <div class="section-heading">
        <p class="eyebrow">Close to home</p>
        <h2 class="section-title">Local care, familiar paths.</h2>
        <p class="section-copy">Based in Derbyshire and covering a friendly neighbourhood of nearby communities.</p>
      </div>
      <div class="relative mx-auto max-w-4xl overflow-hidden rounded-3xl border border-gold/65 bg-white/30 p-6 sm:p-8">
        <div class="mb-6 flex flex-col items-center justify-center gap-3"><span class="flex h-12 w-12 items-center justify-center rounded-full bg-olive text-cream"><Icon name="pin" class="h-6 w-6" /></span><h3 class="font-display text-2xl font-semibold">Areas covered</h3></div>
        <ul class="mx-auto flex max-w-2xl flex-wrap justify-center gap-3">
          {business.areas.map((area) => <li class="rounded-full border border-gold/60 bg-cream px-5 py-2.5 text-sm leading-6 sm:text-base">{area}</li>)}
        </ul>
      </div>
    </section>
    <section id="contact" class="site-shell pb-10 sm:pb-12 lg:pb-14">
      <div class="relative overflow-hidden rounded-3xl bg-olive px-6 py-8 text-cream sm:px-10 sm:py-10">
        <div class="relative mx-auto max-w-3xl">
          <p class="eyebrow text-cream/90">A happy tail starts here</p>
          <h2 class="section-title">Tell us a little about your best friend.</h2>
          <p class="section-copy text-cream/90">Get in touch to chat about the kind of walks or care that would suit your dog.</p>
          <div class="button-row mt-8">
            <a href={business.phoneHref} class="action-button bg-cream text-forest hover:bg-white"><Icon name="phone" class="h-5 w-5 shrink-0" />{business.phone}</a>
            <a href={`mailto:${business.email}`} class="action-button border border-cream/60 text-cream hover:bg-cream/10"><Icon name="mail" class="h-5 w-5 shrink-0" />Email us</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer class="border-t border-gold/50 text-center">
    <div class="site-shell flex flex-col items-center gap-6 py-8">
      <p class="text-xs text-olive">© {new Date().getFullYear()} {business.name}</p>
    </div>
  </footer>
</BaseLayout>
<script>
  const menu = document.querySelector('header details');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.removeAttribute('open')));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.hasAttribute('open')) {
      menu.removeAttribute('open');
      menu.querySelector('summary')?.focus();
    }
  });
</script>
