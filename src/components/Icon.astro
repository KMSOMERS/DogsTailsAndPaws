---
interface Props {
  name: 'arrow' | 'phone' | 'mail' | 'pin' | 'check' | 'menu' | 'walk' | 'paw' | 'bowl' | 'home';
  class?: string;
}
const { name, class: className = 'h-5 w-5' } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M4 12h15" /><path d="m13 5 7 7-7 7" /></>}
  {name === 'phone' && <path d="M7.2 3.8 9.4 3c.7-.2 1.4.2 1.6.9l1 3.1c.2.6 0 1.2-.5 1.6l-1.4 1.1a14 14 0 0 0 5.2 5.2l1.1-1.4c.4-.5 1-.7 1.6-.5l3.1 1c.7.2 1.1.9.9 1.6l-.8 2.2c-.3.8-1.1 1.3-2 1.2C10.8 18 6 13.2 6 7.8c-.1-.9.4-1.7 1.2-2Z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'pin' && <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16" /></>}
  {name === 'walk' && <><circle cx="15.5" cy="4.5" r="2" /><path d="m13 9-2 4 3 2 1 5m-4-7-3 4-4 1m9-8 3 2 3 1" /><path d="M5 21h15" /></>}
  {name === 'paw' && <><ellipse cx="12" cy="15.5" rx="5" ry="4" fill="currentColor" stroke="none" /><ellipse cx="5.8" cy="9" rx="2" ry="2.7" fill="currentColor" stroke="none" /><ellipse cx="10" cy="5.5" rx="2" ry="2.7" fill="currentColor" stroke="none" /><ellipse cx="14.5" cy="5.5" rx="2" ry="2.7" fill="currentColor" stroke="none" /><ellipse cx="18.5" cy="9" rx="2" ry="2.7" fill="currentColor" stroke="none" /></>}
  {name === 'bowl' && <><path d="M4 11c.5 6 3.2 9 8 9s7.5-3 8-9H4Z" /><path d="M3 11h18M8 7c.5-1 1.5-1 2 0m4 0c.5-1 1.5-1 2 0" /></>}
  {name === 'home' && <><path d="m3 11 9-7 9 7v9H3v-9Z" /><path d="M9 20v-6h6v6" /></>}
</svg>
