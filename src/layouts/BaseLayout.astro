---
import '../styles/global.css';
import { business } from '../content/business';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${business.name} | Dog walking & care in Derbyshire`,
  description = `${business.tagline} Dog walking, puppy visits, welfare visits and pet sitting across Derbyshire.`
} = Astro.props;
const socialImage = new URL('/assets/social-preview.png', Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f0e2" />
    <link rel="icon" href="/assets/paw-logo.svg" type="image/svg+xml" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
